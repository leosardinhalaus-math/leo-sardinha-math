config_version=5

[application]
config/name="Calculus Royale: Matemática em Batalha"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/icon.svg"

[autoload]
Cards="*res://data/CardDatabase.gd"
Islands="*res://data/IslandDatabase.gd"
Game="*res://scripts/GameManager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1152
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.023, 0.047, 0.09, 1)

[physics]
common/physics_ticks_per_second=30

[audio]
driver/enable_input=false
